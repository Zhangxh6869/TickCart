# 复制为 .env 后使用（docker compose 会自动读取仓库根目录的 .env）
#   cp .env.example .env
#
# JWT 密钥用于签发 access/refresh token，务必替换成随机值：
#   openssl rand -base64 48
JWT_SECRET=please-change-this-to-a-random-48-byte-string

# MySQL root 密码（容器内网使用，无需暴露到宿主机）
MYSQL_ROOT_PASSWORD=root

# 基础镜像前缀。留空 = 直接用官方镜像名（maven/node/nginx/eclipse-temurin）。
# 若 `docker pull nginx` 超时（国内直连 docker.io 常见），二选一：
#   A. 给 Docker Desktop 配 registry-mirrors（推荐，一次配好所有镜像都走加速）
#   B. 在下面填加速器前缀（注意结尾要带斜杠）
#      配了 A 就保持留空
REGISTRY=

# 依赖仓库镜像（构建时用，直连官方源在国内常超时）
MAVEN_MIRROR=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com
